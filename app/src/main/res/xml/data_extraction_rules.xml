<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="known-hosts" />
        <exclude domain="file" path="trusted_certs" />
        <exclude domain="sharedpref" path="clipboard_consent.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="known-hosts" />
        <exclude domain="file" path="trusted_certs" />
        <exclude domain="sharedpref" path="clipboard_consent.xml" />
    </device-transfer>
</data-extraction-rules>
